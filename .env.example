# =========================================================
# 1. FRONTEND ENVIRONMENT VARIABLES (Vite / Browser Client)
# =========================================================
# Configuración de Firebase BaaS (Authentication & Firestore)
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# Modo Demo: activo automáticamente si no se configuran variables de Firebase
VITE_DEMO_MODE=true

# =========================================================
# 2. SERVERLESS FUNCTION ENVIRONMENT VARIABLES (Vercel Backend)
# NUNCA usar el prefijo VITE_ en estas variables para no exponer secretos en el navegador
# =========================================================
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_SES_SOURCE_EMAIL=notifications@matecode.com
